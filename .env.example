# GEMINI_API_KEY: Required for Gemini AI proof verification, AI dare coach, and AI generation
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The base URL of your deployed application (e.g. https://your-app.onrender.com)
APP_URL="https://your-app.onrender.com"

# Stripe Payments & Subscriptions
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Google Maps Platform (Optional for live proximity heatmap view)
VITE_GOOGLE_MAPS_API_KEY=""

# Firebase Configuration (Optional: defaults to auto-provisioned applet config)
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""

# External Analytics Capture (Optional: Google Analytics 4, PostHog, etc.)
VITE_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
VITE_POSTHOG_KEY=""

# Node Environment
NODE_ENV="production"
